NODE_ENV=development
PORT=4000
# URL PostgreSQL applicative ; jamais dans le frontend
DATABASE_URL=postgresql://user:password@localhost:5432/gainde
# Facultatif : URL réservée aux migrations avec un rôle propriétaire habilité.
# DIRECT_URL=postgresql://user:password@direct-host/gainde
# HTTPS obligatoire hors local
FRONTEND_ORIGINS=http://localhost:3000
# Dokploy/Traefik : 1 uniquement si aucun accès direct au port public
TRUST_PROXY_HOPS=0
# Secret partagé uniquement entre serveurs Next/Nest pour la limitation par visiteur.
# CONTACT_PROXY_SECRET=generate_a_random_secret_of_at_least_32_characters

# Médias Boutique : trois valeurs Cloudinary exclusivement côté backend.
# Sans ces trois variables, gestion des brouillons possible, upload indisponible (503).
# Ne jamais utiliser de préfixe NEXT_PUBLIC_ pour API_SECRET ; aucune clé réelle en Git.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_numeric_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# E-mails clients : uniquement backend, toutes les valeurs doivent être configurées ensemble.
# Google exige un mot de passe d’application, jamais le mot de passe habituel.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=gaindesportif@gmail.com
# SMTP_PASSWORD=your_private_google_app_password
# MAIL_FROM=gaindesportif@gmail.com
# MAIL_ENCRYPTION_KEY=your_private_32_byte_key_encoded_as_base64
# CUSTOMER_SITE_URL=https://gaindesportif.com
